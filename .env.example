# Copy this file to .env.local and fill in values from Supabase Project Settings -> API Keys.
# Never commit .env.local or put a service_role / secret key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Keep false for the private starter-guide beta. Enable only after deploying guided-ai and setting a hosted provider secret.
VITE_GUIDED_AI_ENABLED=false
